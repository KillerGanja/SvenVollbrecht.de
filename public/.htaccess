RewriteEngine On

# ---------------------------------------------------------------
# Performance: Kompression, Caching, Sicherheits-Header
# (alles in <IfModule>, damit ein fehlendes Apache-Modul nie einen 500er ausloest)
# ---------------------------------------------------------------

# Gehashte Astro-Dateien (/_astro/...) aendern ihren Namen bei jeder Aenderung -> 1 Jahr cachen
RewriteRule ^_astro/ - [E=ASTRO_ASSET:1]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType video/quicktime .mov
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML immer frisch pruefen, damit Aenderungen aus dem Admin sofort sichtbar sind
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  # Bilder/Videos: 1 Monat (der Kuenstler kann Dateien unter gleichem Namen ersetzen)
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType video/quicktime "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_ASSET
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Redirect legacy work paths to localized works paths
RewriteRule ^trust/?$ /de/works/trust/ [R=301,L]
RewriteRule ^circle/?$ /de/works/circle/ [R=301,L]

# English versions if they exist or just generalize
RewriteRule ^en/trust/?$ /en/works/trust/ [R=301,L]
RewriteRule ^en/circle/?$ /en/works/circle/ [R=301,L]

# Weiterleitungen alter Werk-Adressen auf die neuen Slugs (kleingeschrieben, Bindestrich)
