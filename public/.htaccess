RewriteRule ^en/works/Bestimmung/?$ /en/works/bestimmung/ [R=301,L]
RewriteRule ^de/works/Circle/?$ /de/works/circle/ [R=301,L]
RewriteRule ^en/works/Circle/?$ /en/works/circle/ [R=301,L]
RewriteRule ^de/works/compliane/?$ /de/works/compliance/ [R=301,L]
RewriteRule ^en/works/compliane/?$ /en/works/compliance/ [R=301,L]
RewriteRule ^de/works/\.Ccompliane/?$ /de/works/compliance/ [R=301,L]
RewriteRule ^en/works/\.Ccompliane/?$ /en/works/compliance/ [R=301,L]
RewriteRule ^de/works/Compliance/?$ /de/works/compliance/ [R=301,L]
RewriteRule ^en/works/Compliance/?$ /en/works/compliance/ [R=301,L]
