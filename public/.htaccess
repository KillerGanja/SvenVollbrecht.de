# Ausstellungen: Slug-Tippfehler korrigiert (schoenebrger-art -> schoeneberger-art)
RewriteRule ^de/exhibitions/schoenebrger-art/?$ /de/exhibitions/schoeneberger-art/ [R=301,L]
RewriteRule ^en/exhibitions/schoenebrger-art/?$ /en/exhibitions/schoeneberger-art/ [R=301,L]
