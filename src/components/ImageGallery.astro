---
import ResponsiveImage from "./ResponsiveImage.astro";
import {
  getImageInfo,
  isOptimizable,
  variantUrl,
  widthsFor,
} from "../utils/image-variants.mjs";

const { images, title = "" } = Astro.props;

// Fuer jedes Bild: kleine Vorschau (Responsive) + grosse Variante fuer die Lightbox.
// Die Lightbox-Groesse kommt direkt vom Server, die Originale werden nicht mehr vorab geladen.
const items = await Promise.all(
  (Array.isArray(images) ? images : []).map(async (src: string) => {
    const info =
      import.meta.env.DEV || !isOptimizable(src)
        ? null
        : await getImageInfo(src);
    if (!info) return { src, href: src, w: 0, h: 0, ratio: 0 };
    const widths = widthsFor(info.width);
    const big = widths[widths.length - 1];
    return {
      src,
      href: variantUrl(src, big),
      w: big,
      h: Math.round((big * info.height) / info.width),
      ratio: info.width / info.height,
    };
  }),
);
---

<link
  rel="stylesheet"
  href="https://unpkg.com/photoswipe@5/dist/photoswipe.css"
/>

<div class="gallery" id="work-gallery">
  {
    items.map((it) => (
      <a
        href={it.href}
        data-pswp-width={it.w || undefined}
        data-pswp-height={it.h || undefined}
      >
        <ResponsiveImage
          src={it.src}
          alt={title}
          sizes={
            it.ratio
              ? `(max-width: 480px) ${Math.round(it.ratio * 200)}px, (min-width: 768px) ${Math.round(it.ratio * 350)}px, ${Math.round(it.ratio * 250)}px`
              : undefined
          }
        />
      </a>
    ))
  }
</div>

<script type="module">
  import PhotoSwipe from "https://unpkg.com/photoswipe@5/dist/photoswipe.esm.js";

  const gallery = document.getElementById("work-gallery");
  if (gallery) {
    const links = Array.from(gallery.querySelectorAll("a"));

    // Nur fuer Bilder ohne bekannte Groesse (z. B. Dev-Server): Groesse beim Klick ermitteln
    const measure = (href) =>
      new Promise((resolve) => {
        const img = new Image();
        img.onload = () =>
          resolve({ w: img.naturalWidth, h: img.naturalHeight });
        img.onerror = () => resolve({ w: 1600, h: 1200 });
        img.src = href;
      });

    links.forEach((link, index) => {
      link.addEventListener("click", async (e) => {
        e.preventDefault();

        // Alle Bilder der Galerie in der Lightbox, Start beim angeklickten Bild
        const dataSource = await Promise.all(
          links.map(async (l) => {
            let w = parseInt(l.getAttribute("data-pswp-width") || "0", 10);
            let h = parseInt(l.getAttribute("data-pswp-height") || "0", 10);
            if (!w || !h) ({ w, h } = await measure(l.href));
            return {
              src: l.href,
              w,
              h,
              alt: l.querySelector("img")?.alt || "",
            };
          }),
        );

        const pswp = new PhotoSwipe({
          dataSource,
          index,
          closeOnVerticalDrag: true,
        });
        pswp.init();
      });
    });
  }
</script>

<style>
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.5rem 0;
    justify-content: center; /* Center items in the row */
  }

  .gallery a {
    height: 250px; /* Default height */
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  /* Responsive height adjustment */
  @media (min-width: 768px) {
    .gallery a {
      height: 350px;
    }
  }

  @media (max-width: 480px) {
    .gallery a {
      height: 200px;
    }
  }

  /* :global, weil das <img> aus der Kind-Komponente ResponsiveImage kommt (Astro-Scoping) */
  .gallery :global(img) {
    height: 100%;
    width: auto; /* Width adjusts to maintain aspect ratio */
    object-fit: contain; /* Ensure no cropping */
    border-radius: 6px;
    cursor: zoom-in;
    display: block; /* Remove bottom space */
  }

  .gallery a:hover {
    transform: scale(1.02);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
  }
</style>
